+class ProfilerStepCallback(TrainerCallback):
+    """Advance the torch_npu profiler schedule after every global optimizer step.
+
+    ``on_optimizer_step`` fires once per optimizer step (the gradient-accumulation
+    boundary inside the Transformers Trainer), never per dataloader micro-batch.
+    """
+
+    def __init__(self, controller: ProfilerController) -> None:
+        self.controller = controller
+
+    def on_optimizer_step(self, args, state, control, **kwargs):
+        self.controller.step()
+        return control
+
